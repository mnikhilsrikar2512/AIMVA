# Copy to backend/.env and fill in. Never commit .env.

# --- Core ---
# Leave SECRET_KEY empty to auto-generate one in data/.secret_key
SECRET_KEY=
PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
# Platform owners (comma-separated emails) who can open Owner → Quality & usage
ADMIN_EMAILS=
# Allow user-added AI providers on local/private addresses (Ollama, ComfyUI). Defaults to true only when PUBLIC_URL is localhost.
ALLOW_PRIVATE_PROVIDERS=

# --- Email: Gmail SMTP with an App Password ---
# 1. Turn on 2-Step Verification on the Google account
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# Without these, verification codes are printed in the backend console (dev mode).
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
MAIL_FROM=

# --- AI: platform keys, server-side only (never sent to the browser; see docs/AI_KEYS.md) ---
# Every AI feature runs on these keys. Each capability resolves: its own PROVIDER + API_KEY, then the
# legacy variables below, then the shared AI_PROVIDER/AI_API_KEY (if that provider can do it), then the fallback.
# One key for everything:
AI_PROVIDER=
AI_API_KEY=
# Or one per capability (provider names: gemini, fal, sarvam, openai; leave empty to skip):
TEXT_PROVIDER=
TEXT_API_KEY=
TEXT_MODEL=
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_EDIT_PROVIDER=
IMAGE_EDIT_API_KEY=
IMAGE_EDIT_MODEL=
VIDEO_PROVIDER=
VIDEO_API_KEY=
VIDEO_MODEL=
# Multilingual voice (Hindi, Bengali, Tamil, Telugu, Gujarati, Kannada, Malayalam, Marathi, Punjabi, Odia + English)
TTS_PROVIDER=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=
VOICE_CALL_PROVIDER=
VOICE_CALL_API_KEY=
VOICE_CALL_MODEL=
# Legacy names, still read (writing / images+video+editing / multilingual voice):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FAL_KEY=
SARVAM_API_KEY=
# Customers bringing their own AI keys (Settings → AI providers): off for this version.
ALLOW_USER_AI_KEYS=false
# Image editing models on fal.ai, one per task. Leave empty for the defaults; set one to switch to a better model
# without code changes. A replacement must take the same inputs (see backend/app/image_edit.py).
# change or add in a spot (default fal-ai/flux-pro/v1/fill)
EDIT_MODEL_FILL=
# remove objects cleanly (default fal-ai/bria/eraser)
EDIT_MODEL_REMOVE=
# whole-image changes from a sentence (default fal-ai/flux-pro/kontext)
EDIT_MODEL_INSTRUCT=
# select the clicked object (default fal-ai/sam2/image)
EDIT_MODEL_SEGMENT=
# find the main subject for background swaps (default fal-ai/birefnet)
EDIT_MODEL_CUTOUT=
# AI upscaling (default fal-ai/clarity-upscaler)
EDIT_MODEL_UPSCALE=
# Optional key for the free FLUX images (keyless = 1 image every 45 s for the whole server). https://enter.pollinations.ai
POLLINATIONS_TOKEN=
# Keyless free fallback for writing and images when no key is set (true/false). Development only: shared,
# rate-limited and watermarked. Production sets this to false (deploy/.env.example).
FREE_AI=true

# --- OAuth apps (connect later; see docs/INTEGRATIONS.md) ---
META_APP_ID=
# Also used to verify WhatsApp webhook signatures. Required on a public server or every WhatsApp webhook is rejected.
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- WhatsApp Cloud API webhook verify token ---
WHATSAPP_VERIFY_TOKEN=aimva-verify

# --- Twilio (optional default for phone calls) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Storage (optional) ---
# Where brand logos and branded images are kept; defaults to backend/data/uploads
UPLOADS_DIR=

# Work agents: background scheduler (Lead Concierge follow-ups, Campaign Autopilot daily, Weekly Report on Mondays)
AGENTS_SCHEDULER=true
# Business time zone offset from UTC in minutes, for "9 am" and "Monday" (330 = India)
TZ_OFFSET_MINUTES=330

# --- Production (see docs/DEPLOY.md; deploy/.env.example has the full production set) ---
# development or production. Production refuses to start with unsafe settings and lists them.
ENVIRONMENT=development
# Error tracking: a Sentry (or GlitchTip) DSN. Empty = off.
SENTRY_DSN=
# text (terminal) or json (log services); DEBUG / INFO / WARNING
LOG_FORMAT=text
LOG_LEVEL=INFO
# Postgres connection pool per worker
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- Ad platform API versions (change when Google / LinkedIn retire one) ---
GOOGLE_ADS_API_VERSION=v21
LINKEDIN_API_VERSION=202510

# --- Billing (built, switched off; see docs/INTEGRATIONS.md) ---
BILLING_ENFORCE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_AGENCY=
