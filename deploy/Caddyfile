# HTTPS for the app domain, plus on-demand certificates for customers' own domains (custom domains on sites).
# Caddy asks AIMVA before issuing a certificate, so only domains a customer has added and verified get one.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:8000/api/public/domains/allowed
	}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000
}

# Customers' domains pointed at this server (CNAME or A record) serve their published site.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy app:8000
}
