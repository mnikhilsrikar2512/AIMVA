# Production settings for deploy/docker-compose.yml. Copy to deploy/.env and fill in. Never commit .env.
# The app refuses to start if anything unsafe is left (it lists exactly what).

# --- Server ---
# The domain users open (point its DNS A record at this server first)
DOMAIN=app.example.com
# Email for Let's Encrypt expiry notices
ACME_EMAIL=you@example.com
# Long random values: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
SECRET_KEY=
ENVIRONMENT=production
COOKIE_SECURE=true
ALLOW_PRIVATE_PROVIDERS=false
# Server processes. 2 is right for a 2 GB server; add one per extra GB.
WEB_CONCURRENCY=2
ADMIN_EMAILS=you@example.com

# --- Error tracking (free tier at sentry.io, or self-hosted GlitchTip) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Backups ---
BACKUP_KEEP_DAYS=14
# 21:00 UTC = 02:30 India
BACKUP_HOUR_UTC=21
BACKUP_DIR=./backups

# --- Email (required in production: sign-up codes go by email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- WhatsApp and Meta (required: webhooks are verified with the app secret) ---
META_APP_ID=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Optional integrations (see backend/.env.example for what each does) ---
# AI platform keys (server-side only; full list and resolution order in backend/.env.example and docs/AI_KEYS.md)
AI_PROVIDER=
AI_API_KEY=
TEXT_PROVIDER=
TEXT_API_KEY=
IMAGE_PROVIDER=
IMAGE_API_KEY=
VIDEO_PROVIDER=
VIDEO_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=
STT_PROVIDER=
STT_API_KEY=
GEMINI_API_KEY=
FAL_KEY=
SARVAM_API_KEY=
ALLOW_USER_AI_KEYS=false
POLLINATIONS_TOKEN=
# The keyless free fallback is for development only.
FREE_AI=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AGENTS_SCHEDULER=true
TZ_OFFSET_MINUTES=330

# --- Billing (off until set) ---
BILLING_ENFORCE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_AGENCY=
